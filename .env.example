PROJECT_NAME=CareWayV

DB_USER=carewayv
DB_PASSWORD=carewayv_dev
DB_HOST=127.0.0.1
DB_PORT=55432
DB_NAME=carewayv

CAREWAYV_API_PORT=8000
CAREWAYV_FRONTEND_PORT=5173

# Wayfinding API configuration
API_V1_PREFIX=/api/v1
WAYFINDING_PREFIX=/wayfinding
WAYFINDING_TAG=Wayfinding
WAYFINDING_CACHE_CONTROL=no-store
WAYFINDING_ERROR_STATUS='{"kiosk_not_found":404,"kiosk_conflict":409,"invalid_audio":422,"voice_not_configured":503,"transcription_failed":502}'

# Optional connection override for Alembic on the host.
# DATABASE_URL=postgresql+psycopg://carewayv:your_password@127.0.0.1:55432/carewayv

# Optional for /api/v1/wayfinding/voice. Keep the real key in .env.
OPENROUTER_API_KEY=
OPENROUTER_STT_MODEL=openai/whisper-large-v3-turbo
OPENROUTER_TTS_MODEL=elevenlabs/eleven-flash-v2.5
OPENROUTER_TTS_VOICE=george

# Optional: call ElevenLabs directly (STT + TTS). Takes priority over OpenRouter when set.
# Create a key at https://elevenlabs.io/app/settings/api-keys
ELEVENLABS_API_KEY=
ELEVENLABS_STT_MODEL=scribe_v1
ELEVENLABS_TTS_MODEL=eleven_flash_v2_5
ELEVENLABS_VOICE_ID=JBFqnCBsd6RMkjVDRZzb
# Live conversation (needs ELEVENLABS_API_KEY): realtime STT model and the silence that ends a spoken turn.
ELEVENLABS_REALTIME_MODEL=scribe_v2_realtime
VOICE_END_SILENCE_SECS=0.5
